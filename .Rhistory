#load geo data
world <- ne_countries(scale = 110, type = "countries", returnclass = "sf")%>%
# Convert WGS84 to projected crs
sf::st_transform(world_ne, crs="ESRI:54030")
#bring in flight data
mapdata <- median_df_joined_noCOVID
#bring in entropy risk data
data <- results_medianrisk_df
#join risk and flight data
mapdata <- mapdata %>%
left_join(data, by = c("date" = "date", "Country" = "Country"))
#remove regions from data
mapdata <- mapdata %>%
filter(!(Country %in% c("Portugal", "France", "Germany", "Nepal", "Africa", "Americas", "Europe", "CentralAmerica", "EastAfrica", "EastAsia", "Asia", "MiddleAfrica","SouthAmerica", "WestAfrica", "SouthAsia", "median_p", "Caribbean", "SoutheastAsia")))
#Change country names to remove spaces so it matches geo data
mapdata <- mapdata %>%
mutate(Country = ifelse(Country == "DominicanRepublic", "DominicanRepublic", Country))
mapdata <- mapdata %>%
mutate(Country = ifelse(Country == "UnitedKingdom", "United Kingdom", Country))
mapdata <- mapdata %>%
mutate(Country = ifelse(Country == "CostaRica", "Costa Rica", Country))
#Summarise data by country
mapdata <- mapdata %>%
group_by(Country) %>%
summarise(
risk_sum = sum(Overall_risk, na.rm = TRUE),
risk_mean = mean(Overall_risk, na.rm = TRUE),
risk_med = median(Overall_risk, na.rm = TRUE),
risk_sd = sd(Overall_risk, na.rm = TRUE),
Transmission_Pot = mean(Transmission_Pot, na.rm = TRUE),
passenger_count = sum(passenger_count, na.rm = TRUE)
) %>%
data.frame()
